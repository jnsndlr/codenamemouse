; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Codename: Mouse"
config/description="Top-down isometric, class-based capture the flag at mouse scale."
run/main_scene="res://scenes/maps/arena.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://scripts/input_setup.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[navigation]

; Voxel resolution the navmesh is baked at, and it has to be set at mouse scale rather than
; left at Godot's human-scale 0.25. A mouse is 0.32 across, so a quarter-metre voxel is a third
; of the character -- gaps it fits through vanish, and every agent dimension gets rounded to
; something that isn't what you asked for. A region whose cell size differs from the map's is
; rejected outright, which is why this is a project setting rather than a knob on the region.
3d/default_cell_size=0.1
3d/default_cell_height=0.1

[physics]

3d/default_gravity=20.0

[rendering]

; MSAA off, deliberately. Antialiasing spends effort softening exactly the hard edges the
; pixel pass exists to produce, and a smoothed depth buffer blurs the steps it detects them
; from. Turn this back on only if the pixel pass is removed.
anti_aliasing/quality/msaa_3d=0
