; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Codename: Mouse"
config/description="Top-down isometric, class-based capture the flag at mouse scale."
config/version="0.1.0-alpha"
run/main_scene="res://scenes/ui/title.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Codename Mouse"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/png/app-icon-1024.png"

[autoload]

InputSetup="*res://scripts/input_setup.gd"
Screenshot="*res://scripts/game/screenshot.gd"
Net="*res://scripts/net/net_session.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[navigation]

3d/default_cell_size=0.1
3d/default_cell_height=0.1

[physics]

3d/default_gravity=20.0

[rendering]

textures/vram_compression/import_etc2_astc=true
